# Google Gemini API Key
# Used for natural female teacher explanations & primary Gemini TTS
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Model name for Gemini Text-to-Speech (defaults to gemini-2.0-flash)
GEMINI_TTS_MODEL=gemini-2.0-flash

# Default Fallback Voice: en-IN-NeerjaNeural (Free Edge TTS, Indian English Female)
DEFAULT_VOICE=en-IN-NeerjaNeural

# Optional: ElevenLabs API Key for modular premium speech integration
ELEVENLABS_API_KEY=

# Server Port
PORT=8000
